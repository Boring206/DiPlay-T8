    <string name="wheel_key_service_description">讓 DiPlay 使用在設定中選擇的方向盤按鍵縮放儀表盤上的 CarPlay 地圖，並在 CarPlay 螢幕上移動選擇。它只接收按鍵，不讀取螢幕內容。</string>
    <string name="cluster_song_on_change">僅在切歌時顯示</string>
    <string name="cluster_song_on_change_description">新歌曲在儀表盤上顯示 5 秒，然後清空卡片。暫停和繼續播放不會再次顯示。</string>
    <string name="cluster_safe_area_edit">儀表安全區域 · 編輯框</string>
    <string name="cluster_safe_area_reset">重置儀表安全區域</string>
    <string name="cluster_safe_area_hint">拖動四條綠色邊界，儲存後在下次 CarPlay 連線時生效。自定義區域會替代車輛標記偏移，重置後恢復。</string>
    <string name="cluster_safe_area_live_hint">在此拖動綠色邊界，儀表會同步顯示區域框。儲存後重新連線生效；取消保留當前區域。</string>
    <string name="oem_cluster_map">隱藏原車儀表地圖</string>
    <string name="oem_cluster_map_description">可選：DiPlay 投屏期間暫停原車地圖的儀表投屏。關閉時不修改原車地圖。元件模式只隱藏儀表投屏，整包模式會禁用整個原車地圖，停止投屏後恢復原狀態。需要已授權的本地 ADB，重新連線後生效。</string>
    <string name="oem_cluster_hold_off">關閉</string>
    <string name="oem_cluster_hold_component">只隱藏儀表投屏</string>
    <string name="oem_cluster_hold_package">禁用整個原車地圖</string>
    <string name="song_on_hud">HUD 顯示曲名或歌詞</string>
    <string name="song_on_hud_description">無導航指引時顯示手機提供的曲名或歌詞，導航方向和道路名稱優先。</string>
    <string name="hotspot_network_not_ready">熱點網路未就緒</string>
    <string name="first_tcp_timeout">iPhone 沒有透過 Wi-Fi 連上 CarPlay。請確認 DiPlay 裡儲存的熱點名稱和密碼與車機熱點完全一致，並關閉 iPhone 的個人熱點。</string>
    <string name="wireless_startup_retries_exhausted">自動重試已停止，請檢查連線後手動重試。</string>
    <string name="retry_carplay_connection">重新連線</string>
    <string name="check_title">車機相容性檢查</string>
    <string name="check_bt_missing">這台車機沒有可供 App 使用的 Android 系統藍牙，無法使用無線 CarPlay。</string>
    <string name="check_bt_off">系統藍牙未開啟，請在系統藍牙設定中開啟。</string>
    <string name="check_bt_permission">DiPlay 尚未獲準讀取已配對的藍牙裝置。</string>
    <string name="check_bt_on">系統藍牙可用。</string>
    <string name="check_phone_none">系統藍牙沒有配對任何手機。請在系統藍牙設定中配對 iPhone；只在車機自帶的電話 App 裡配對是不夠的。</string>
    <string name="check_phone_ok">已配對 iPhone：%1$s</string>
    <string name="check_phone_choose">已配對 %1$d 台裝置，但沒有名稱含 iPhone 的。請選擇哪一台是你的 iPhone。</string>
    <string name="check_wifi_missing">這台車機沒有可供 App 使用的 Wi-Fi。</string>
    <string name="check_hotspot_not_saved">車機熱點的名稱和密碼尚未儲存到 DiPlay。</string>
    <string name="check_hotspot_on">車機熱點已開啟。</string>
    <string name="check_hotspot_off">車機熱點未開啟，請先開啟再連線。</string>
    <string name="check_hotspot_unknown">DiPlay 無法讀取這台車機的熱點狀態，請確認車機熱點已開啟。</string>
    <string name="check_joined_phone_hotspot">車機目前連線著 iPhone 的個人熱點。請關閉 iPhone 個人熱點：使用 CarPlay 時必須由 iPhone 加入車機的熱點。</string>
    <string name="check_wifi_5ghz">Wi-Fi 支援 5 GHz。</string>
    <string name="check_wifi_24ghz">Wi-Fi 僅支援 2.4 GHz。CarPlay 可以連線，但畫面和聲音可能卡頓。</string>
    <string name="check_wifi_band_unknown">DiPlay 無法讀取這台車機支援的 Wi-Fi 頻段。</string>
    <string name="check_decoder_ok">有可用的 H.264 視訊解碼器。</string>
    <string name="check_decoder_missing">找不到 H.264 視訊解碼器，無法顯示 CarPlay 畫面。</string>
    <string name="check_decoder_unknown">DiPlay 無法列出這台車機的視訊解碼器。</string>
    <string name="report_lan_hint">同一 Wi-Fi 下的電腦也可以讀取報告：\n%1$s</string>
    <string name="connection_detail_title">排查用的詳細資訊</string>
    <string name="hotspot_read_from_car">車機回報的熱點名稱：%1$s</string>
    <string name="hotspot_use_car_values">使用車機目前的名稱和密碼</string>
    <string name="check_hotspot_mismatch">DiPlay 裡儲存的熱點名稱或密碼，與車機目前的熱點（%1$s）不一致。</string>
    <string name="auto_connect_on_bluetooth_title">iPhone 藍牙連上時自動連線</string>
    <string name="auto_connect_on_bluetooth_description">所選的 iPhone 一連上車機藍牙，就自動開啟 DiPlay 並開始無線 CarPlay。</string>
    <string name="auto_car_hotspot_plain_description">連線時由 DiPlay 自動開啟車機熱點，不必手動操作。第一次開啟時，請在彈出的畫面中允許 DiPlay 修改系統設定。不會自動關閉熱點。</string>
    <string name="check_hotspot_auto">車機熱點目前未開啟，連線時 DiPlay 會自動開啟。</string>
    <string name="app_hotspot_title">DiPlay 自建熱點</string>
    <string name="app_hotspot_description">不必輸入名稱和密碼：連線時由 DiPlay 自己開一個臨時熱點。需要開啟定位，並關閉車機自帶的熱點。</string>
    <string name="app_hotspot_hint">DiPlay 自建熱點 · 保持藍牙和 iPhone 的 Wi-Fi 開啟。</string>
    <string name="check_location_off">定位未開啟。Android 只在定位開啟時才允許應用自建熱點。</string>
    <string name="check_open_location_settings">開啟定位設定</string>
    <string name="check_app_hotspot_conflict">車機自帶的熱點正開著。請先關閉它，DiPlay 才能自建熱點；或者改用車載熱點方式。</string>
    <string name="app_hotspot_failed">DiPlay 無法在這台車機上自建熱點。請確認定位已開啟、車機自帶熱點已關閉；或到“連線設定”改用“車載熱點”。</string>
    <string name="hands_free_title">以後自動連線？</string>
    <string name="hands_free_message_bluetooth">CarPlay 已在這台車機上成功連線。以後只要 iPhone 連上車機藍牙，DiPlay 就可以自動開啟並連線。之後可在“設定”中更改。</string>
    <string name="hands_free_message">CarPlay 已在這台車機上成功連線。以後只要開啟 DiPlay 就可以自動連線。之後可在“設定”中更改。</string>
    <string name="hands_free_accept">自動連線</string>
</resources>
